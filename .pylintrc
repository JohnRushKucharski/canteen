[MESSAGES CONTROL]
disable =
    # Protocol classes and test classes intentionally have few methods.
    # This rule produces false positives for Protocol-based designs (ADR-0002).
    too-few-public-methods,

    # TODO comments are tracked in GitHub Issues, not via pylint.
    fixme,

    # Factory functions (e.g. reservoir.factory) legitimately require many
    # arguments because they mirror the full construction surface of the object.
    too-many-arguments,
    too-many-positional-arguments,

    # Operations.operate() and its concrete implementations declare *args/**kwargs
    # as part of the Protocol signature for future extensibility.  Concrete
    # implementations (e.g. PassiveOperations) are required to accept them even
    # though they are not used, so that callers can pass extra kwargs without
    # conditional dispatch.  This is not a code smell.
    unused-argument,

[FORMAT]
max-line-length = 100
